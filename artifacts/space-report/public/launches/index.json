{
  "methods": {
    "surrogate": {
      "title": "Surrogate (published-profile)",
      "summary": "Event knots (time, altitude, velocity) from official vehicle brochures/user manuals, interpolated every 5 s and laid along a constant-azimuth rhumb line from the pad (azimuth from NOTAM/hazard areas or from target inclination). One assumption splits horizontal motion from the published profile. Where a vehicle has no published profile, a family stand-in (LM-3B from the CALT manual) is used and labelled. ILLUSTRATIVE, not telemetry."
    },
    "sim": {
      "title": "First-principles 3DOF sim",
      "summary": "Point-mass ascent simulator: rotating WGS-84 Earth with J2 gravity, US76 atmosphere drag, pressure-dependent thrust, staging/boosters/fairing/coasts; vertical rise, pitch kick, gravity turn then linear-tangent guidance optimized (Nelder-Mead) to reach the target orbit along the launch azimuth. Stage parameters from OSINT, each number sourced, derived or labelled an assumption. ILLUSTRATIVE, not telemetry. Long March vehicles run in timeline mode: published ignition/cutoff/separation times are hard events, burn rates from published thrust/Isp, and remaining free parameters fitted (bounded least squares) to the CALT manual LM-3B profile (altitude within 3.4 km at all events)."
    },
    "methods_doc": "/launches/METHODS.md"
  },
